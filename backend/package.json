{
  "name": "backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "db:preflight:schema": "tsx src/scripts/schemaPreflight.ts",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:migrate:baseline-existing": "prisma migrate resolve --applied 20260210150000_init --schema prisma/schema.prisma && prisma migrate resolve --applied 20260211120000_hardening --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "seed:bootstrap": "tsx src/seed/bootstrapAdmin.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/session": "^11.1.0",
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.1",
    "zod": "^3.25.76",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.16.5",
    "prisma": "^6.5.0",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "tsx": "^4.19.4",
    "vitest": "^3.2.4"
  }
}
