generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SALES_REP
}

enum CommissionModel {
  MODEL_A
  MODEL_B
}

enum LeadStatus {
  NEW
  ADVANCE_PAID
  BUILDING
  PREVIEW_SENT
  FINAL_PAID
  DEPLOYED
  COMMISSION_PAID
}

enum PaymentKind {
  ADVANCE
  FINAL
}

enum PaymentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ActivityAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  PAYMENT_MARKED
  PAYMENT_VERIFIED
  COMMISSION_PAID
  PASSWORD_CHANGED
  EXPORT
  SETTINGS_UPDATE
}

enum ProspectCategory {
  NEW_LEAD
  CALLBACK_REQUESTED
  NO_ANSWER
  INTERESTED
  FOLLOW_UP
  NOT_INTERESTED
}

model WebsiteTemplate {
  id          String  @id
  slug        String  @unique
  name        String
  displayCode String  @unique
  categoryId  String
  sampleSlug  String  @unique
  samplePath  String?
  sortOrder   Int     @default(0)
  leads       Lead[]
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  passwordHash         String
  displayName          String?
  role                 UserRole
  commissionModel      CommissionModel?
  isActive             Boolean   @default(true)
  archivedAt           DateTime?
  mustChangePassword   Boolean   @default(false)
  failedLoginAttempts  Int       @default(0)
  lockedUntil          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  leadsCreated   Lead[]          @relation("LeadCreatedBy")
  leadsAssigned  Lead[]          @relation("LeadAssignedTo")
  prospectCategoryEvents LeadProspectCategoryEvent[] @relation("ProspectCategoryEventBy")
  paymentsMarked LeadPayment[]   @relation("PaymentMarkedBy")
  paymentsVerified LeadPayment[] @relation("PaymentVerifiedBy")
  commissions    Commission[]    @relation("CommissionRep")
  commissionsPaid Commission[]   @relation("CommissionPaidBy")
  activityLogs   ActivityLog[]
  notifications  PortalNotification[]
  leadScraperQuota LeadScraperUserQuota?
  leadScraperPlaceViews LeadScraperPlaceView[]
  leadScraperSearchCaches LeadScraperSearchCache[] @relation("LeadScraperSearchBy")

  @@index([role])
  @@index([role, isActive])
  @@index([archivedAt])
  @@index([email])
  @@index([lockedUntil])
}

model Lead {
  id               String      @id @default(cuid())
  createdByUserId  String
  assignedToUserId String?
  clientName       String
  clientEmail      String?
  clientPhone      String?
  notes            String?
  status           LeadStatus  @default(NEW)
  advanceAmountCents Int?
  finalQuoteCents    Int?
  agreedTotalCents   Int?
  websiteTemplateId  String?
  contentReceivedAt  DateTime?
  convertedAt          DateTime?
  clientDetailsSubmittedAt DateTime?
  clientDetailsVerifiedAt  DateTime?
  whatsappGroupLink    String?
  whatsappVerifiedAt   DateTime?
  demoFinalizedAt           DateTime?
  demoFinalizedVerifiedAt   DateTime?
  accountsReadyAt      DateTime?
  accountsReadyVerifiedAt DateTime?
  /** GitHub username for client hosting account (rep submits at accounts_ready). */
  clientGithubId       String?
  /** Email used to create the client's GitHub account. */
  clientGithubEmail    String?
  /** GitHub repo URL after ownership transfer to client (admin records at repo_transfer verify). */
  transferredGithubRepoUrl String?
  repoTransferVerifiedAt  DateTime?
  /** Per-stage admin decline context keyed by pipeline stage (e.g. accounts_ready). */
  stageDeclineNotes    Json?
  prospectCategory     ProspectCategory @default(NEW_LEAD)
  callbackScheduledAt  DateTime?
  interestedSampleShared Boolean?
  /** Google Places place_id when imported from lead scraper. */
  googlePlaceId        String?   @unique
  scraperImportedAt    DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  createdBy   User           @relation("LeadCreatedBy", fields: [createdByUserId], references: [id])
  assignedTo  User?          @relation("LeadAssignedTo", fields: [assignedToUserId], references: [id])
  websiteTemplate WebsiteTemplate? @relation(fields: [websiteTemplateId], references: [id], onDelete: SetNull)
  payments    LeadPayment[]
  project     Project?
  commission  Commission?
  notifications PortalNotification[]
  prospectCategoryEvents LeadProspectCategoryEvent[]

  @@index([status])
  @@index([createdByUserId])
  @@index([assignedToUserId])
  @@index([createdAt])
  @@index([websiteTemplateId])
  @@index([convertedAt])
  @@index([prospectCategory])
  @@index([assignedToUserId, createdAt])
  @@index([assignedToUserId, prospectCategory])
}

model LeadScraperUserQuota {
  userId          String   @id
  monthlyQuota    Int      @default(150)
  searchesUsed    Int      @default(0)
  quotaResetMonth String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LeadScraperGlobalUsage {
  yearMonth   String   @id
  searchCount Int      @default(0)
  lastUpdated DateTime @updatedAt
}

model LeadScraperSearchCache {
  id               String   @id @default(cuid())
  locationKey      String
  keyword          String   @default("business")
  resultsJson      Json
  resultCount      Int      @default(0)
  noWebsiteCount   Int      @default(0)
  lat              Float?
  lng              Float?
  searchedByUserId String?
  searchedAt       DateTime @default(now())

  searchedBy User? @relation("LeadScraperSearchBy", fields: [searchedByUserId], references: [id], onDelete: SetNull)

  @@unique([locationKey, keyword])
  @@index([locationKey, keyword])
}

model LeadScraperPlace {
  id                  String   @id @default(cuid())
  placeId             String   @unique
  name                String
  address             String?
  phone               String?
  category            String?
  hasWebsite          Boolean  @default(false)
  websiteUrl          String?
  mapsUrl             String?
  lat                 Float?
  lng                 Float?
  sourceSearchCacheId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  views LeadScraperPlaceView[]

  @@index([hasWebsite])
}

model LeadScraperPlaceView {
  /** One org-wide claim per place — first rep to discover owns it. */
  placeId   String   @id
  userId    String
  viewedAt  DateTime @default(now())

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  place LeadScraperPlace @relation(fields: [placeId], references: [placeId], onDelete: Cascade)

  @@index([userId, viewedAt])
}

model LeadProspectCategoryEvent {
  id              String           @id @default(cuid())
  leadId          String
  category        ProspectCategory
  note            String?
  callbackAt      DateTime?
  sampleShared    Boolean?
  createdAt       DateTime         @default(now())
  createdByUserId String

  lead      Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy User @relation("ProspectCategoryEventBy", fields: [createdByUserId], references: [id])

  @@index([leadId, createdAt])
}

model PortalSettings {
  id        String   @id @default("default")
  values    Json
  updatedAt DateTime @updatedAt
}

model LeadPayment {
  id                   String                     @id @default(cuid())
  leadId               String
  kind                 PaymentKind
  amountCents          Int
  repNote              String?
  markedByUserId       String
  markedAt             DateTime                   @default(now())
  verificationStatus   PaymentVerificationStatus @default(PENDING)
  verifiedByUserId     String?
  verifiedAt           DateTime?
  adminNote            String?
  externalReference      String?

  lead           Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  markedBy       User @relation("PaymentMarkedBy", fields: [markedByUserId], references: [id])
  verifiedBy     User? @relation("PaymentVerifiedBy", fields: [verifiedByUserId], references: [id])

  @@index([leadId])
  @@index([verificationStatus])
}

model Project {
  id                     String    @id @default(cuid())
  leadId                 String    @unique
  title                  String
  metadata               Json?
  previewUrl             String?
  deployedUrl            String?
  deploymentSubmittedAt  DateTime?
  deploymentVerifiedAt   DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Commission {
  id             String    @id @default(cuid())
  leadId         String    @unique
  repUserId      String
  amountCents    Int
  bonusCents     Int       @default(0)
  isPaid         Boolean   @default(false)
  paidAt         DateTime?
  paidByAdminId  String?
  createdAt      DateTime  @default(now())

  lead    Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  rep     User  @relation("CommissionRep", fields: [repUserId], references: [id])
  paidBy  User? @relation("CommissionPaidBy", fields: [paidByAdminId], references: [id])

  @@index([repUserId])
  @@index([isPaid])
}

enum PortalNotificationKind {
  REP_SUBMITTED
  ADMIN_VERIFIED
  ADMIN_DECLINED
}

model PortalNotification {
  id        String                 @id @default(cuid())
  userId    String
  leadId    String
  kind      PortalNotificationKind
  stageKey  String?
  message   String
  readAt    DateTime?
  createdAt DateTime               @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([leadId])
  @@index([createdAt])
}

model ActivityLog {
  id          String         @id @default(cuid())
  userId      String?
  action      ActivityAction
  entityType  String
  entityId    String
  ip          String?
  userAgent   String?
  before      Json?
  after       Json?
  createdAt   DateTime       @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

/** Server-side session rows for @fastify/session (shared across app instances). */
model PortalSession {
  sid       String   @id
  data      Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
  @@map("portal_sessions")
}
