{
  "public": "dist",
  "rewrites": [
    {
      "source": "/samples/websites/car-wash-auto-care-website/**",
      "destination": "/samples/websites/car-wash-auto-care-website/index.html"
    },
    {
      "source": "/samples/websites/gym-ironforge-website/**",
      "destination": "/samples/websites/gym-ironforge-website/index.html"
    },
    {
      "source": "/samples/websites/yoga-ananda-website/**",
      "destination": "/samples/websites/yoga-ananda-website/index.html"
    },
    {
      "source": "/samples/websites/florist-bloom-vine-website/**",
      "destination": "/samples/websites/florist-bloom-vine-website/index.html"
    },
    {
      "source": "/samples/websites/realestate-verdant-heights-website/**",
      "destination": "/samples/websites/realestate-verdant-heights-website/index.html"
    },
    {
      "source": "/samples/websites/toy-store-playhouse-website/**",
      "destination": "/samples/websites/toy-store-playhouse-website/index.html"
    },
    {
      "source": "/samples/websites/restaurant-fire-town-website/**",
      "destination": "/samples/websites/restaurant-fire-town-website/index.html"
    },
    { "source": "!/samples/**", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "**/*.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
